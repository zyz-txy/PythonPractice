   "source": [
    "import pandas as pd\n",
    "#读取数据\n",
    "df = pd.read_csv('data/sales.csv',nrows=10)\n",
    "\n",
    "#根据销售数量降序排序\n",
    "df.sort_values('销售数量',ascending=False)\n",
    "#根据单价升序排序\n",
    "df.sort_values(['单价'],ascending=[True])#ascending=True可省略\n",
    "#根据价格升序排序，价格一样的再根据销售数量降序排序\n",
    "df.sort_values(['单价','销售数量'],ascending=[True,False])"
   ],
